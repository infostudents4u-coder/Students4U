    <a href="privacy.html">Privacyverklaring</a>
    <a href="cookies.html">Cookiebeleid</a>
  </div>

  <div class="copyright">
    © 2026 Students4U. Alle rechten voorbehouden.
  </div>
</footer>

</body>
</html>
